# ==========================================
# NormaHub Telegram Bot Starter Config (.env)
# ==========================================

# 1. Telegram Credentials (Получить у @BotFather)
BOT_TOKEN=1234567890:AAHxxxxxx_example_token_from_botfather

# 2. NormaHub AI Gateway (Получить на https://normahub.cc)
NORMAHUB_API_KEY=nr_hub_your_api_key_here
NORMAHUB_BASE_URL=https://api.normahub.cc/v1

# 3. Model Configuration
# Рекомендуемые: deepseek-v4.1-flash (быстрый и дешевый), claude-sonnet-5-5 (флагман логики и кода)
DEFAULT_MODEL=deepseek-v4.1-flash

# 4. Streaming & Debouncer
# Интервал обновления сообщения в Telegram (в секундах, защита от FloodWait)
STREAM_DEBOUNCE_INTERVAL=0.8

# 5. Conversation Memory (Sliding Window)
# Максимальное количество парных ходов диалога (user + assistant) в памяти
MAX_CONTEXT_TURNS=10
SYSTEM_PROMPT="Ты — полезный, умный и вежливый AI-ассистент в Telegram. Отвечай структурированно, используй Markdown."

# 6. Throttling / Rate Limiting
# Минимальная пауза в секундах между запросами одного пользователя
RATE_LIMIT_PER_SECOND=1.0

# 7. Infrastructure & State Storage
# Опциональный Redis URL для FSM и хранения стейта (для Docker Compose раскомментируйте redis://redis:6379/0)
# REDIS_URL=redis://localhost:6379/0

# 8. Administration & Logging
# Список Telegram ID администраторов через JSON-массив, например [123456789, 987654321]
ADMIN_USER_IDS=[]
LOG_LEVEL=INFO
